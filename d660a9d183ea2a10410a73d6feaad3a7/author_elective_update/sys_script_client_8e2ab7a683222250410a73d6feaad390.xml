        <field>postal_code</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Auto Populate using pincode</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
    var ga = new GlideAjax('PinCodeHelper');
	
  ga.addParam('sysparm_name', 'getLocationByPin');
  ga.addParam('sysparm_postal_code', newValue);
  ga.getXMLAnswer(function(response) {
    var data = JSON.parse(response);
	alert(data);
    if (data && !data.error) {
      g_form.setValue('city', data.city);
      
      g_form.setValue('state', data.state);
    }
   
	else {
      g_form.showFieldMsg('postal_code', 'Invalid or unrecognized PIN Code', 'error');
    }
  });
   //Type appropriate comment here, and begin script below
   
}]]></script>
