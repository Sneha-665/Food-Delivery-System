        <messages/>
        <name>Contact Number Verification</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
  if (isLoading || !newValue) return;
 
  var cleaned = newValue.trim();
 
  var fieldName = 'contact_number';
  var phoneRegex = /^\d{10}$/;
 
  if (!phoneRegex.test(cleaned)) {
    g_form.showFieldMsg(fieldName, 'Phone number must be exactly 10 digits.', 'error');
  } else {
    g_form.hideFieldMsg(fieldName, true);
  }
}
 ]]></script>
