        <script><![CDATA[var menuFilter = Class.create();
menuFilter.prototype = {
    initialize: function() {},

    menuValidator: function(restaurant) {
        var filter = [];
        var ids;
        var gr = new GlideRecord('x_946454_food_de_0_menu_items');
        gr.addQuery('restaurant_name=' + restaurant);
        while (gr.next()) {
            filter.push(gr.sys_id);
        }
        ids = 'sys_idIN' + filter;
        return ids;
    },

    type: 'menuFilter'
};]]></script>
